{
  "name": "@tbca/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Geteilte Zod-Schemas, Typen und Konstanten für Web, API und Bots",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
