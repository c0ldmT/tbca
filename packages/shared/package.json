{
  "name": "@tbca/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Geteilte Zod-Schemas, Typen und Konstanten für Web, API und Bots",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@tbca/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "@tbca/source": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./names": {
      "@tbca/source": "./src/names.ts",
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tbca/game-core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
