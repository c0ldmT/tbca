{
  "name": "@tbca/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST-API (NestJS mit Fastify): Login, Sessions, Spielfunktionen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@tbca/source --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@tbca/db": "workspace:*",
    "@tbca/game-core": "workspace:*",
    "@tbca/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "iovalkey": "0.4.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "exports": {
    "./app": {
      "@tbca/source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./env": {
      "@tbca/source": "./src/config/env.ts",
      "types": "./dist/config/env.d.ts",
      "default": "./dist/config/env.js"
    }
  }
}
