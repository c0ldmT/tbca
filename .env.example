# TBCA – Umgebungsvariablen
#
# Vorlage für .env.development (scripts/setup.sh) und .env.production (scripts/setup.sh --prod).
# Platzhalter __SECRET__ und __DB_PASSWORD__ werden beim Anlegen durch Zufallswerte ersetzt.
# Echte Werte (Passwörter, Tokens, Secrets) gehören NIE ins Repo.

# development | production
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tbca
POSTGRES_USER=tbca
POSTGRES_PASSWORD=__DB_PASSWORD__
# Verbindungs-URL für die Apps; muss zu den Werten oben passen.
DATABASE_URL=postgres://tbca:__DB_PASSWORD__@localhost:5432/tbca

# --- Valkey (Cache, Cooldowns, Jobs) -----------------------------------------
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
