# TBCA – Umgebungsvariablen
#
# Vorlage für .env.development (scripts/setup.sh) und .env.production (scripts/setup.sh --prod).
# Platzhalter __SECRET__ und __DB_PASSWORD__ werden beim Anlegen durch Zufallswerte ersetzt.
# Echte Werte (Passwörter, Tokens, Secrets) gehören NIE ins Repo.

# development | production
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
# Bewusst nicht 5432, damit ein lokal installiertes Postgres nicht kollidiert.
POSTGRES_PORT=55432
POSTGRES_DB=tbca
POSTGRES_USER=tbca
POSTGRES_PASSWORD=__DB_PASSWORD__
# Verbindungs-URL für die Apps. Leer = die Scripts setzen sie aus den POSTGRES_*-Werten zusammen.
DATABASE_URL=

# --- Valkey (Cache, Cooldowns, Jobs) -----------------------------------------
# Bewusst nicht 6379, damit ein lokales Redis/Valkey nicht kollidiert.
VALKEY_PORT=56379
# Leer = redis://localhost:<VALKEY_PORT>
VALKEY_URL=

# Optional: eigene, leere Datenbank für die Integrationstests von @tbca/db.
# Achtung: Die Tests löschen ihren Inhalt bei jedem Lauf.
# TBCA_TEST_DATABASE_URL=postgres://tbca:__DB_PASSWORD__@localhost:55432/tbca_test

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Hinter Caddy (Produktion) auf true setzen.
TRUST_PROXY=false
DB_MAX_CONNECTIONS=10
# Öffentliche Adresse der Website (ohne / am Ende). In der Entwicklung leitet
# der Angular-Dev-Server /api an die API weiter, daher Port 4200.
WEB_ORIGIN=http://localhost:4200
# Weitere Adressen der Website, Komma-getrennt (z. B. http://192.168.178.20:4200 im Heimnetz).
# scripts/dev.sh lan ergänzt die LAN-Adresse automatisch.
WEB_EXTRA_ORIGINS=
# Testzugang ohne Discord (Anmeldung per Name). Nur Entwicklung; in Produktion verboten.
DEV_LOGIN=false
# Signiert Cookies; mindestens 32 Zeichen, wird von setup.sh erzeugt.
COOKIE_SECRET=__SECRET__
# Secure-Flag für Cookies. Leer = nur bei NODE_ENV=production.
COOKIE_SECURE=
SESSION_TTL_DAYS=30
# Zeitzone für Spieltage und Tageslimits
GAME_TIMEZONE=Europe/Berlin

# --- Discord (https://discord.com/developers/applications) --------------------
# Getrennte Apps für Entwicklung und Produktion. Redirect in der Discord-App eintragen:
#   <WEB_ORIGIN>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional, Standard: <WEB_ORIGIN>/api/auth/discord/callback
DISCORD_REDIRECT_URI=
# Bot der Discord-App (Reiter „Bot“); ohne Token startet der Bot nicht.
DISCORD_BOT_TOKEN=
# Slash-Commands nur auf diesem Server registrieren (sofort sichtbar); leer = global.
DISCORD_DEV_GUILD_ID=

# --- Bots ---------------------------------------------------------------------
# Bots rufen die interne API mit diesem Token auf; wird von setup.sh erzeugt.
BOT_SERVICE_TOKEN=__SECRET__
API_INTERNAL_URL=http://127.0.0.1:3000/api

# --- Produktion (nur .env.production) ---------------------------------------
# Domain, unter der TBCA erreichbar ist; Caddy holt dafür automatisch ein Zertifikat.
TBCA_DOMAIN=
# Kontakt für Let's Encrypt
ACME_EMAIL=
# standard = API und Bot getrennt (VPS), compact = alles in einem Prozess (Raspberry Pi 3)
TBCA_PROFILE=standard
# Präfix der Docker-Images (z. B. ghcr.io/c0ldmt/tbca bei einer Registry)
TBCA_IMAGE_PREFIX=tbca
# Anzahl aufbewahrter Datenbank-Backups
BACKUP_KEEP=14
# Ressourcen; leer = Standardwerte des Profils (siehe docs/deployment.md)
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
PG_MAX_CONNECTIONS=
VALKEY_MAXMEMORY=
NODE_MAX_OLD_SPACE=
# Rate-Limits: Anfragen je Minute und Client; Login strenger
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
