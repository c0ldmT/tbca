# TBCA – Umgebungsvariablen
#
# Vorlage für .env.development (scripts/setup.sh) und .env.production (scripts/setup.sh --prod).
# Platzhalter __SECRET__ und __DB_PASSWORD__ werden beim Anlegen durch Zufallswerte ersetzt.
# Echte Werte (Passwörter, Tokens, Secrets) gehören NIE ins Repo.

# development | production
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
# Bewusst nicht 5432, damit ein lokal installiertes Postgres nicht kollidiert.
POSTGRES_PORT=55432
POSTGRES_DB=tbca
POSTGRES_USER=tbca
POSTGRES_PASSWORD=__DB_PASSWORD__
# Verbindungs-URL für die Apps. Leer = die Scripts setzen sie aus den POSTGRES_*-Werten zusammen.
DATABASE_URL=

# --- Valkey (Cache, Cooldowns, Jobs) -----------------------------------------
# Bewusst nicht 6379, damit ein lokales Redis/Valkey nicht kollidiert.
VALKEY_PORT=56379
# Leer = redis://localhost:<VALKEY_PORT>
VALKEY_URL=

# Optional: eigene, leere Datenbank für die Integrationstests von @tbca/db.
# Achtung: Die Tests löschen ihren Inhalt bei jedem Lauf.
# TBCA_TEST_DATABASE_URL=postgres://tbca:__DB_PASSWORD__@localhost:55432/tbca_test

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Hinter Caddy (Produktion) auf true setzen.
TRUST_PROXY=false
DB_MAX_CONNECTIONS=10
# Öffentliche Adresse der Website (ohne / am Ende). In der Entwicklung leitet
# der Angular-Dev-Server /api an die API weiter, daher Port 4200.
WEB_ORIGIN=http://localhost:4200
# Signiert Cookies; mindestens 32 Zeichen, wird von setup.sh erzeugt.
COOKIE_SECRET=__SECRET__
# Secure-Flag für Cookies. Leer = nur bei NODE_ENV=production.
COOKIE_SECURE=
SESSION_TTL_DAYS=30
# Zeitzone für Spieltage und Tageslimits
GAME_TIMEZONE=Europe/Berlin

# --- Discord (https://discord.com/developers/applications) --------------------
# Getrennte Apps für Entwicklung und Produktion. Redirect in der Discord-App eintragen:
#   <WEB_ORIGIN>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional, Standard: <WEB_ORIGIN>/api/auth/discord/callback
DISCORD_REDIRECT_URI=
